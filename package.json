{
  "name": "@opensite/ui",
  "version": "0.0.8",
  "description": "Foundational UI component library for OpenSite Semantic Site Builder with tree-shakable exports and abstract styling",
  "keywords": [
    "react",
    "performance",
    "pagespeed",
    "tree-shakeable",
    "semantic-ui",
    "shadcn",
    "tailwind"
  ],
  "homepage": "https://github.com/opensite-ai/opensite-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opensite-ai/opensite-ui.git"
  },
  "bugs": {
    "url": "https://github.com/opensite-ai/opensite-ui/issues"
  },
  "author": "OpenSite AI (https://opensite.ai)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.js",
      "require": "./dist/components.cjs"
    },
    "./components/container": {
      "types": "./dist/container.d.ts",
      "import": "./dist/container.js",
      "require": "./dist/container.cjs"
    },
    "./components/section": {
      "types": "./dist/section.d.ts",
      "import": "./dist/section.js",
      "require": "./dist/section.cjs"
    },
    "./components/animated-dialog": {
      "types": "./dist/animated-dialog.d.ts",
      "import": "./dist/animated-dialog.js",
      "require": "./dist/animated-dialog.cjs"
    },
    "./components/page-hero-banner": {
      "types": "./dist/page-hero-banner.d.ts",
      "import": "./dist/page-hero-banner.js",
      "require": "./dist/page-hero-banner.cjs"
    },
    "./components/button": {
      "types": "./dist/button.d.ts",
      "import": "./dist/button.js",
      "require": "./dist/button.cjs"
    },
    "./components/card": {
      "types": "./dist/card.d.ts",
      "import": "./dist/card.js",
      "require": "./dist/card.cjs"
    },
    "./components/badge": {
      "types": "./dist/badge.d.ts",
      "import": "./dist/badge.js",
      "require": "./dist/badge.cjs"
    },
    "./components/popover": {
      "types": "./dist/popover.d.ts",
      "import": "./dist/popover.js",
      "require": "./dist/popover.cjs"
    },
    "./components/dynamic-icon": {
      "types": "./dist/dynamic-icon.d.ts",
      "import": "./dist/dynamic-icon.js",
      "require": "./dist/dynamic-icon.cjs"
    },
    "./components/pressable": {
      "types": "./dist/pressable.d.ts",
      "import": "./dist/pressable.js",
      "require": "./dist/pressable.cjs"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "import": "./dist/hooks.js",
      "require": "./dist/hooks.cjs"
    },
    "./hooks/use-navigation": {
      "types": "./dist/use-navigation.d.ts",
      "import": "./dist/use-navigation.js",
      "require": "./dist/use-navigation.cjs"
    },
    "./blocks/about/alternating-blocks": {
      "types": "./dist/alternating-blocks.d.ts",
      "import": "./dist/alternating-blocks.js",
      "require": "./dist/alternating-blocks.cjs"
    },
    "./blocks/cta/media-hover-ctas": {
      "types": "./dist/media-hover-ctas.d.ts",
      "import": "./dist/media-hover-ctas.js",
      "require": "./dist/media-hover-ctas.cjs"
    },
    "./blocks/features/feature-showcase": {
      "types": "./dist/feature-showcase.d.ts",
      "import": "./dist/feature-showcase.js",
      "require": "./dist/feature-showcase.cjs"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js",
      "require": "./dist/registry.cjs"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js",
      "require": "./dist/utils.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:ci": "./scripts/test-ci-silent.sh",
    "type-check": "tsc --noEmit",
    "size": "bash -c 'size-limit --silent 2>/dev/null'",
    "prepublishOnly": "pnpm run build && pnpm run test:ci"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.10",
    "@vitest/ui": "^4.0.10",
    "happy-dom": "^20.0.10",
    "jsdom": "^27.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "size-limit": "^11.1.6",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.0.10"
  },
  "dependencies": {
    "@opensite/hooks": "^0.1.1",
    "@page-speed/img": "^0.4.3",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.2.0",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0"
  },
  "optionalDependencies": {
    "@legendapp/state": "^3.0.0-beta.42",
    "valibot": "^1.2.0"
  },
  "packageManager": "pnpm@9.14.4",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  }
}
